{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FishVN",
  "identifier": "com.fishvn.app",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build:frontend",
    "devUrl": "http://127.0.0.1:4545",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FishVN",
        "width": 1920,
        "height": 1114,
        "minWidth": 960,
        "minHeight": 634,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**/*"]
      }
    }
  },
  "bundle": {
    "active": false
  }
}