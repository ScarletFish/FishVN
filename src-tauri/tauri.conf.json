{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FishVN",
  "identifier": "FishVN",
  "build": {
    "beforeDevCommand": "npm run dev:frontend",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:4545",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FishVN",
        "width": 1920,
        "height": 1114,
        "minWidth": 1014,
        "minHeight": 648,
        "center": true,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#f1f0ec"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../LICENSE": "licenses/LICENSE",
      "resources/vndb/ATTRIBUTION.md": "licenses/ATTRIBUTION.md",
      "resources/licenses/OFL.txt": "licenses/OFL.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}