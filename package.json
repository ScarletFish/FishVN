{
  "name": "fishvn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "set FISHVN_DEV_HTTP=1&& tauri dev",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "check:comments": "node scripts/check-comments.mjs",
    "check:frontend": "npm run check:comments && npm run check:frontend --prefix frontend",
    "check:rust": "npm run check:comments && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --quiet"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.9.0"
  }
}